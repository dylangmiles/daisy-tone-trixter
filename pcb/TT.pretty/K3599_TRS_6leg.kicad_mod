(footprint "K3599_TRS_6leg"
	(version 20240108)
	(generator "tt_measured")
	(layer "F.Cu")
	(descr "Mantech K3599 1/4in (6.35mm) 3-conductor CLOSED (switched) open-frame phone jack, 6 solder lugs. MEASURED off the real part 2026-10-10 (recalibrated caliper): thin leg 1.34mm (through the board), along-row pitch 6.36mm c-c (3 legs/row), row spacing 16.55mm c-c (17.89 outside-to-outside - 1.34 leg; legs FLEX in this direction so holes are generous), lug width 20mm, jack length 34.12mm, barrel axis 12.39mm below the board (bottom-mount drop). Barrel/bushing IN LINE with the legs at the +Y (back-wall) end; body extends -Y (forward, below the board). Pads 1/2/3 = Tip/Ring/Sleeve (match the Conn_01x03 symbol); the 3 unnumbered pads are the switch lugs (soldered, no net in v1). BOTTOM-MOUNTED: place on B.Cu so the body hangs below the board. @@ VERIFY the T/R/S lug assignment with a meter, and the leg-row->barrel-face along-length distance (barrel Y here is approximate), before fab. @@")
	(tags "jack TRS 6.35mm phone K3599 open-frame switched measured")
	(attr through_hole)
	(property "Reference" "REF**"
		(at 0 -11 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "K3599"
		(at 0 19 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Footprint" "" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
	(fp_text user "${REFERENCE}"
