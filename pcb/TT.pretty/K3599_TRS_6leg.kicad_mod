(footprint "K3599_TRS_6leg"
	(version 20240108)
	(generator "tt_firstpass")
	(layer "F.Cu")
	(descr "Mantech K3599 1/4in (6.35mm) 3-conductor CLOSED (switched) open-frame phone jack, 6 solder lugs. From the datasheet drawing: body 30mm long x 18.5mm wide, 2 lug rows 12mm apart, lugs 1.5x3.0mm, barrel hole O6.5, bushing M9, BARREL AXIS 12mm off the mounting plane. The barrel/bushing is IN LINE with the legs at the +Y end (faces the back wall). Pads 1/2/3 = Tip/Ring/Sleeve (match the Conn_01x03 symbol); the 3 unnumbered pads are the switch lugs (soldered, no net in v1). BOTTOM-MOUNTED: place on B.Cu so the body hangs below the board. @@ VERIFY: the along-length lug pitch (7mm here is ESTIMATED from the drawing) and the Tip/Ring/Sleeve lug assignment (meter the real part) before fab. @@")
	(tags "jack TRS 6.35mm phone K3599 open-frame switched VERIFY")
	(attr through_hole)
	(property "Reference" "REF**"
		(at 0 -12 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "K3599"
		(at 0 20 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Footprint" "" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1.27 1.27))))
	(fp_text user "${REFERENCE}"
		(at -11 0 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15))))
	(fp_text user "barrel / plug  -->  back wall"
		(at 0 16 0)
		(layer "F.Fab")
		(effects (font (size 0.7 0.7) (thickness 0.1))))

	(pad "1" thru_hole circle (at -6 -7) (size 2.8 2.8) (drill 1.7) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole circle (at -6 0)  (size 2.8 2.8) (drill 1.7) (layers "*.Cu" "*.Mask"))
	(pad "3" thru_hole circle (at -6 7)  (size 2.8 2.8) (drill 1.7) (layers "*.Cu" "*.Mask"))
	(pad "" thru_hole circle (at 6 -7) (size 2.8 2.8) (drill 1.7) (layers "*.Cu" "*.Mask"))
	(pad "" thru_hole circle (at 6 0)  (size 2.8 2.8) (drill 1.7) (layers "*.Cu" "*.Mask"))
	(pad "" thru_hole circle (at 6 7)  (size 2.8 2.8) (drill 1.7) (layers "*.Cu" "*.Mask"))

	(fp_text user "1=TIP(deep)" (at -9.5 -7 90) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.1))))
	(fp_text user "3=SLV(near)" (at -9.5 7 90) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.1))))

	(fp_line (start -9.25 -11) (end 9.25 -11) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start -9.25 -11) (end -9.25 10) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start 9.25 -11) (end 9.25 10) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start -9.25 10) (end 9.25 10) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_circle (center 0 13.5) (end 3.25 13.5) (stroke (width 0.2) (type default)) (fill no) (layer "F.SilkS"))
	(fp_circle (center 0 13.5) (end 4.75 13.5) (stroke (width 0.12) (type default)) (fill no) (layer "F.SilkS"))

	(fp_rect (start -10 -12) (end 10 20.5) (stroke (width 0.05) (type default)) (fill no) (layer "F.CrtYd"))
